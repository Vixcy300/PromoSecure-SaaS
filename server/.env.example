# Server Environment Variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/promosecure
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# For MongoDB Atlas (replace with your connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/promosecure

# Security
INITIAL_SETUP_KEY=change_this_to_something_secure_for_admin_registration

# Email Configuration (Gmail SMTP)
# To use: Create a Gmail App Password at https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email settings for OTP/Login
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
